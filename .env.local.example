# Copy this file to `.env.local` and add your real keys.
# Never commit `.env.local` — secrets stay on your machine / host only.

OPENAI_API_KEY=your-openai-api-key-here

# Supabase (required for Auth + client/session persistence)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — optional. Prefer authenticated clients + RLS for app data.
# Use only for genuine admin tasks (never expose to the browser; never NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# Database migrations (repeatable CLI workflow)
# ---------------------------------------------------------------------------
# Preferred: Supabase CLI — see README "Database migrations".
#
# Database password from the dashboard Connect panel (or Project Settings → Database).
# Used by: npm run db:link / npm run db:push
SUPABASE_DB_PASSWORD=your-database-password

# Optional explicit project ref (otherwise taken from NEXT_PUBLIC_SUPABASE_URL)
# SUPABASE_PROJECT_REF=your-project-ref

# Public HTTPS origin for customer invitation emails (Lead / Manager).
# Required for Owner Console invites when NEXT_PUBLIC_SITE_URL is loopback
# (e.g. local Pilot on http://127.0.0.1:3001). Never use localhost / LAN.
# Pilot: https://pilot.pridmora.com (never platform.pridmora.com).
# Identity: https://platform.pridmora.com.
# Must also be on that project's Supabase Auth Redirect URL allow-list.
# CUSTOMER_INVITE_ORIGIN=https://pilot.pridmora.com

# Legacy / emergency only — direct Postgres URI for npm run db:apply
# Get it from: project dashboard → Connect → Session or Direct → URI
# Replace [YOUR-PASSWORD] with the real database password.
# DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-eu-west-2.pooler.supabase.com:5432/postgres
